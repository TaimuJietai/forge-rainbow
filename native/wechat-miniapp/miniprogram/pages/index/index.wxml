<block wx:if="{{src}}">
  <web-view src="{{src}}" bindload="onWebLoad" binderror="onWebError"></web-view>
</block>
<view wx:else class="fallback">
  <text class="title">无法加载 H5</text>
  <text class="hint">目标地址：https://dv.phb.plus/</text>
  <text class="code" wx:if="{{errorMsg}}">{{errorMsg}}</text>
  <text class="hint">开发者工具请勾选「不校验合法域名、web-view（业务域名）」；正式环境需在公众平台配置业务域名 dv.phb.plus。</text>
</view>
