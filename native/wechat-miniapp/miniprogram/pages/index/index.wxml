<web-view
  src="{{url}}"
  bindload="onWebLoad"
  binderror="onWebError"
  bindmessage="onWebMessage"
/>

<cover-view wx:if="{{showLoading}}" class="loading-mask">
  <cover-view class="loading-box">
    <cover-image class="loading-icon" src="/assets/loading.gif" />
    <cover-view class="loading-text">正在加载中......</cover-view>
  </cover-view>
</cover-view>
