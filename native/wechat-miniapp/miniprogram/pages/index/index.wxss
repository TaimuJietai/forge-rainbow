page {
  width: 100%;
  height: 100%;
  background-color: #ffffff;
}

.loading-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
}

/* configuration/logo/loading.gif，原始 800×600 */
.loading-box {
  position: absolute;
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200px;
  text-align: center;
}

.loading-icon {
  width: 200px;
  height: 150px;
  display: block;
}

.loading-text {
  font-size: 14px;
  color: #8a8a8a;
}
