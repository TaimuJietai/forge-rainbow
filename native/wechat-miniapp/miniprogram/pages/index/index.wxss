.fallback {
  min-height: 100vh;
  padding: 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 20rpx;
  background: #fff;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111;
}

.code,
.hint {
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.code {
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  color: #111;
  font-family: Menlo, Monaco, Consolas, monospace;
}

.hint {
  color: #666;
}
